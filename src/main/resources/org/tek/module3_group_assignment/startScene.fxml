<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.shape.Rectangle?>

<TabPane fx:id="tabPane" prefHeight="430.0" prefWidth="600.0" tabClosingPolicy="UNAVAILABLE" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.tek.module3_group_assignment.startSceneController">
   <tabs>
      <Tab fx:id="maze1Tab" text="Maze 1">
         <content>
            <Pane fx:id="maze1Pane" focusTraversable="true" prefHeight="400.0" prefWidth="600.0">

               <children>

                  <!-- Maze 1 background -->
                  <ImageView fitHeight="400.0" fitWidth="600.0" mouseTransparent="true" preserveRatio="false">
                     <image>
                        <Image url="@../../../images/maze.png" />
                     </image>
                  </ImageView>
                  <Rectangle fx:id="playerCar" fill="TRANSPARENT" height="23.0" layoutX="5.0" layoutY="243.0" width="19.0" />

               </children>
            </Pane>
         </content>
      </Tab>
      <Tab fx:id="maze2Tab" text="Maze 2">
         <content>
            <Pane fx:id="maze2Pane" focusTraversable="true" prefHeight="400.0" prefWidth="600.0">

               <children>

                  <ImageView fitHeight="400.0" fitWidth="600.0" mouseTransparent="true" preserveRatio="false">

                     <image>
                        <Image url="@../../../images/maze2.png" />
                     </image>

                  </ImageView>

               </children>
            </Pane>
         </content>
      </Tab>

   </tabs>
</TabPane>
