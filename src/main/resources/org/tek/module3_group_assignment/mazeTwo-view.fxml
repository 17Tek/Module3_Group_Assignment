<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.Pane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.shape.Polyline?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>

<Pane fx:id="rootPane"
      prefHeight="440.0"
      prefWidth="600.0"
      focusTraversable="true"
      xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.tek.module3_group_assignment.mazeOneController">

    <children>
        <!-- #Kaif: Maze 2 background -->
        <ImageView
                fitWidth="600.0"
                fitHeight="400.0"
                preserveRatio="false"
                mouseTransparent="true">
            <image>
                <Image url="@../../../images/maze2.png" />
            </image>
        </ImageView>

        <Rectangle fx:id="playerCar"
                   height="35"
                   layoutX="25"
                   layoutY="5"
                   width="35" />

        <!-- #Elan: Same as mazeOne but with a bigger droid, a start on the orange dot, and Maze 2's route-->
        <ImageView fx:id="droid" fitWidth="30" fitHeight="30"
                   layoutX="28" layoutY="22"
                   visible="false" mouseTransparent="true">
            <image>
                <Image url="@../../../images/robot.png" />
            </image>
        </ImageView>

        <Polyline fx:id="solutionPath" visible="false"
                  points="28,22, 61,22, 61,328, 260,328, 260,200, 412,200, 412,31, 542,31, 542,350" />

        <Button text="Reset" layoutX="10" layoutY="408"
                focusTraversable="false" onAction="#handleReset" />
        <Button text="Auto Solve" layoutX="70" layoutY="408"
                focusTraversable="false" onAction="#handleAutoSolve" />
        <Label fx:id="statusLabel" layoutX="160" layoutY="412"
               text="Drive with W A S D, or press Auto Solve." />
    </children>

</Pane>